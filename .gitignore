.env
.env.*
.env.local
!.env.example
*.pem
*.key
*.crt
*.csr
*.p12
*.pfx
*.enc
master.key
api_credentials*

# --- Runtime data (volumes) -------------------------------------------
keys/
data/
cache/
backups/
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.tar.gz
kap-*.tar.gz
