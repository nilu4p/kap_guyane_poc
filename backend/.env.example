# ---------------------------------------------------------------------------
# KAP Guyane — configuration (copy to ../.env). Never commit the real file.
# ---------------------------------------------------------------------------

# development | production (production disables the interactive API docs;
# secure cookies are a separate switch, COOKIE_SECURE)
ENVIRONMENT=production

# --- Secrets at rest -------------------------------------------------------
# Fernet key encrypting the webhook, the source API keys and the PKI private keys. Docker deployment:
# generated by `make secrets` in secrets/master_key (Docker secret, outside keys/
# and backups). MASTER_KEY below overrides it (secret manager); keep it empty otherwise.
MASTER_KEY=

# --- First administrator ---------------------------------------------------
# Leave the password empty: a random one is printed ONCE (make admin-password)
# and must be changed at first login.
BOOTSTRAP_ADMIN_USER=admin
BOOTSTRAP_ADMIN_PASSWORD=

# --- Sessions / exposure ---------------------------------------------------
COOKIE_SECURE=false
SESSION_TTL_MINUTES=480
SESSION_IDLE_MINUTES=30
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
# CORS_ORIGINS=["https://kap.example.fr"]

# --- Server deployment (docker compose) ------------------------------------
# Domain name whose DNS A record points to this server (Let's Encrypt certificate).
# DOMAIN=
# LETSENCRYPT_EMAIL=
# CONSOLE_BIND=0.0.0.0

# --- Territory ---------------------------------------------------------------
# Pilot commune opened first (INSEE code). 97311 = Saint-Laurent-du-Maroni.
DEFAULT_COMMUNE=97311
# Open data re-synchronised every N days (0 = manual only).
DATA_REFRESH_DAYS=7

# --- Notifications ---------------------------------------------------------
# Slack / Mattermost / Teams webhook ({channel} or __CHANNEL__ is replaced by the channel:
# veille, analyses, donnees, decisions, securite). Also editable in Administration.
# ALERT_WEBHOOK_URL=

# --- Source API keys (optional) ---------------------------------------------
# Every data source works keyless. A key enables a fallback provider; all are also
# editable (encrypted) in Administration › Paramètres › Clés API des sources.
# Copernicus Data Space Ecosystem — Sentinel Hub OAuth client: Sentinel-2 catalogue
# and imagery when Earth Search (AWS) is unreachable.
# CDSE_CLIENT_ID=
# CDSE_CLIENT_SECRET=
# Protected Planet API token: WDPA protected areas when the UNEP-WCMC server fails.
# PROTECTED_PLANET_TOKEN=
